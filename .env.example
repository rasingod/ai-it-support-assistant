# Copy this file to .env and fill in your key. Never commit the real .env file.

# Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Any model slug available on https://openrouter.ai/models works here.
# Examples: anthropic/claude-3.5-sonnet, openai/gpt-4o-mini, meta-llama/llama-3.1-70b-instruct
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Optional: OpenRouter uses these for analytics/rate-limit attribution.
# https://openrouter.ai/docs#requests
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=AI IT Support Assistant

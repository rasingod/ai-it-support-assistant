# Local Streamlit secrets file (OPTIONAL).
#
# This project primarily reads config from a .env file (see .env.example),
# which works everywhere, including local runs. This file exists only to:
#   1. Silence Streamlit's harmless "No secrets found" console message during
#      local development, by giving it a real file to find, and/or
#   2. Let you test the exact same secrets mechanism used on Streamlit
#      Community Cloud before deploying, if you prefer.
#
# To use it: copy this file to .streamlit/secrets.toml (same folder) and
# fill in real values, OR just leave an empty .streamlit/secrets.toml if you
# only want to silence the console message and are using .env for the real
# key. Never commit the real secrets.toml -- .gitignore already excludes it.

OPENROUTER_API_KEY = "your-openrouter-api-key-here"
OPENROUTER_MODEL = "anthropic/claude-3.5-sonnet"
